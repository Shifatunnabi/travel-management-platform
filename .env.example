# ==============================================================================
#  Tofiza Tours & Travels — Environment Template
# ------------------------------------------------------------------------------
#  Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#      cp .env.example .env.local
#  Every variable here is validated at boot by `lib/env.ts` (zod). A missing or
#  malformed value fails fast on `next dev` / `next build` instead of at runtime.
#  Only `NEXT_PUBLIC_*` vars are exposed to the browser. Never put a secret there.
# ==============================================================================


# ─── Application ──────────────────────────────────────────────────────────────
# Public origin of the app. No trailing slash. Used to build absolute callback
# URLs for SSLCommerz and links inside transactional emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Atlas SRV string or a local mongod. Do NOT put the database name in the path —
# set it in MONGODB_DB_NAME so seed/test scripts can point at a separate db.
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB_NAME=tofiza


# ─── Auth.js / NextAuth v5 (email + password) ─────────────────────────────────
# AUTH_SECRET signs the session JWT. Generate a fresh one per environment:
#     openssl rand -base64 32
# Rotating it invalidates every active session.
AUTH_SECRET=
# Only needed when the deployment origin cannot be inferred (behind a proxy).
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true


# ─── Cloudinary (hotel / room imagery) ────────────────────────────────────────
# Dashboard → Settings → API Keys. The cloud name is also exposed publicly so the
# browser can build delivery URLs; the key and secret stay server-side only and
# are used to sign direct-from-browser uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Root folder every upload is namespaced under, keeps the media library tidy.
CLOUDINARY_FOLDER=tofiza


# ─── Nodemailer / SMTP (transactional email) ──────────────────────────────────
# Booking confirmations, vendor invitations, password resets, disbursement notices.
# Gmail requires an App Password, not your account password.
# Port 465 → SMTP_SECURE=true.  Port 587 → SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Tofiza Tours & Travels
MAIL_FROM_EMAIL=


# ─── SSLCommerz (payment gateway) ─────────────────────────────────────────────
# Sandbox credentials: https://developer.sslcommerz.com/registration/
# Keep SSLCOMMERZ_IS_LIVE=false until the store is approved for production.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false


# ─── Seeding (local + staging only) ───────────────────────────────────────────
# `npm run seed` bootstraps the first platform admin from these values so the
# admin panel is reachable on a fresh database. Leave blank in production.
SEED_PLATFORM_ADMIN_EMAIL=admin@tofiza.com
SEED_PLATFORM_ADMIN_PASSWORD=
